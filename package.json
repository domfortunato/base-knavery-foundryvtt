{
  "name": "base-knavery",
  "version": "1.0.0",
  "description": "Base Knavery - a Foundry VTT system compatible with Knave 2e",
  "type": "module",
  "scripts": {
    "lint": "eslint --ext .js ./module",
    "build:content": "node tools/content/build-content.mjs",
    "build:readme": "node tools/content/build-readme.mjs",
    "build:packs": "node tools/packs.mjs build",
    "extract:packs": "node tools/packs.mjs extract",
    "check:manifest": "node tools/dev/manifest-check.mjs",
    "check:fields": "node tools/dev/field-audit.mjs",
    "check:i18n": "node tools/dev/i18n-check.mjs",
    "check:readme": "node tools/content/build-readme.mjs --check",
    "check:ids": "node tools/dev/ids-check.mjs",
    "check": "npm run check:manifest && npm run check:fields && npm run check:i18n && npm run check:readme && npm run check:ids",
    "dev:smoke": "node tools/dev/e2e-smoke.mjs",
    "dev:players": "node tools/dev/e2e-players.mjs",
    "dev:screens": "node tools/dev/e2e-screens.mjs",
    "dev:fixes": "node tools/dev/e2e-fixes.mjs",
    "dev:chargen": "node tools/dev/e2e-chargen.mjs",
    "dev:print": "node tools/dev/e2e-print.mjs",
    "dev:fresh": "node tools/dev/e2e-fresh.mjs",
    "release": "node tools/release.mjs"
  },
  "author": "Dom Bosco (https://github.com/domfortunato)",
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "@foundryvtt/foundryvtt-cli": "^3.0.4",
    "eslint": "^8.57.0",
    "js-yaml": "^4.1.0",
    "playwright": "1.61.1"
  }
}
